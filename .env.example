# ============================================================
# EL Hedaya Islamic School Website
# Copy values into Vercel Environment Variables.
# NEVER commit real passwords, service-role keys, or access tokens.
# ============================================================

# Existing parent/family portal

# Supabase browser/public configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GALLERY_TABLE=school_gallery
VITE_GALLERY_BUCKET=school-gallery

# Supabase server secret - Vercel/server only
SUPABASE_SERVICE_ROLE_KEY=

# Newsletter / Hostinger SMTP - Vercel/server only
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=newsletter@elhedaya-cic.com
SMTP_PASSWORD=
NEWSLETTER_FROM=EL Hedaya Islamic School <newsletter@elhedaya-cic.com>
NEWSLETTER_REPLY_TO=newsletter@elhedaya-cic.com
PUBLIC_SITE_URL=https://elhedaya-cic.com

# Square Payments
# Use sandbox until end-to-end testing is complete.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_API_VERSION=2026-08-19
