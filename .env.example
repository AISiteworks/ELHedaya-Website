# The existing EL Hedaya parent portal
VITE_PORTAL_URL=https://elhedaya.clemmonsislamiccenter.org/

# Gallery production backend (Supabase)
# Leave these blank to use local preview mode in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GALLERY_TABLE=school_gallery
VITE_GALLERY_BUCKET=school-gallery

# Registration + Square payments (server-side Vercel variables)
# SUPABASE_SERVICE_ROLE_KEY is already used by the newsletter API. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_API_VERSION=2026-08-19
